# Copy this file to .env and configure
# cp env.example .env

# Embedding provider configuration
# Options: openai, local, ollama, mock
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
# Optional override; normally inferred from provider/model
# EMBEDDING_DIMENSION=1024

# OpenAI settings (if using openai provider for embeddings and/or LLM)
OPENAI_API_KEY=sk-your-key-here

# LLM settings for extraction/summarization
LLM_PROVIDER=ollama
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Ollama settings (if using ollama provider for LLM or embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Storage path (LanceDB)
LANCE_DB_PATH=./data/lancedb

# Memory settings
MEMORY_WORTHINESS_THRESHOLD=0.6
CONSOLIDATION_EPISODE_THRESHOLD=5
CONSOLIDATION_AGE_DAYS=7
